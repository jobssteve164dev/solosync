{
  "name": "solosync",
  "displayName": "SoloSync - Local Code Snapshots",
  "description": "Automatically protect a project folder you choose with restorable snapshots in storage you control.",
  "version": "0.0.5",
  "publisher": "SZLK",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jobssteve164dev/solosync.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "backup",
    "snapshot",
    "git",
    "restore",
    "nas",
    "qnap",
    "workspace",
    "ai-coding"
  ],
  "activationEvents": [
    "onView:solosync.history",
    "onStartupFinished",
    "onCommand:solosync.setup",
    "onCommand:solosync.configureSource",
    "onCommand:solosync.configure",
    "onCommand:solosync.openSettings",
    "onCommand:solosync.backupNow",
    "onCommand:solosync.cancelBackup",
    "onCommand:solosync.restoreSnapshot",
    "onCommand:solosync.restoreFile",
    "onCommand:solosync.verifySnapshot"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "solosync.setup",
        "title": "SoloSync: Setup",
        "category": "SoloSync",
        "icon": "$(gear)"
      },
      {
        "command": "solosync.configureSource",
        "title": "SoloSync: Choose Project Folder",
        "category": "SoloSync",
        "icon": "$(root-folder)"
      },
      {
        "command": "solosync.configure",
        "title": "SoloSync: Choose Backup Location",
        "category": "SoloSync",
        "icon": "$(folder-opened)"
      },
      {
        "command": "solosync.openSettings",
        "title": "SoloSync: Open Settings",
        "category": "SoloSync",
        "icon": "$(gear)"
      },
      {
        "command": "solosync.backupNow",
        "title": "SoloSync: Back Up Now",
        "category": "SoloSync",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "solosync.cancelBackup",
        "title": "SoloSync: Cancel Backup",
        "category": "SoloSync",
        "icon": "$(debug-stop)"
      },
      {
        "command": "solosync.restoreSnapshot",
        "title": "SoloSync: Restore Snapshot",
        "category": "SoloSync"
      },
      {
        "command": "solosync.restoreFile",
        "title": "SoloSync: Restore File",
        "category": "SoloSync"
      },
      {
        "command": "solosync.verifySnapshot",
        "title": "SoloSync: Verify Snapshot",
        "category": "SoloSync"
      },
      {
        "command": "solosync.refresh",
        "title": "SoloSync: Refresh History",
        "category": "SoloSync",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "solosync",
          "title": "SoloSync",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "views": {
      "solosync": [
        {
          "id": "solosync.history",
          "name": "Backup History"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "solosync.history",
        "contents": "Choose the project folder SoloSync should protect.\n[Choose Project Folder](command:solosync.configureSource)",
        "when": "!solosync.hasSourceDirectory"
      },
      {
        "view": "solosync.history",
        "contents": "The selected project folder is unavailable.\n[Choose Another Project Folder](command:solosync.configureSource)",
        "when": "solosync.hasSourceDirectory && !solosync.sourceDirectoryAvailable"
      },
      {
        "view": "solosync.history",
        "contents": "Choose where SoloSync should store backups.\n[Set Backup Location](command:solosync.configure)",
        "when": "solosync.hasSourceDirectory && solosync.sourceDirectoryAvailable && !solosync.hasBackupLocation"
      },
      {
        "view": "solosync.history",
        "contents": "The backup location is unavailable. Reconnect it or choose another folder.\n[Choose Another Location](command:solosync.configure)",
        "when": "solosync.hasSourceDirectory && solosync.sourceDirectoryAvailable && solosync.hasBackupLocation && !solosync.backupLocationAvailable"
      },
      {
        "view": "solosync.history",
        "contents": "SoloSync is ready.\n[Create First Backup](command:solosync.backupNow)\n[Change Setup](command:solosync.setup)",
        "when": "solosync.hasSourceDirectory && solosync.sourceDirectoryAvailable && solosync.hasBackupLocation && solosync.backupLocationAvailable"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "solosync.setup",
          "when": "view == solosync.history",
          "group": "navigation@1"
        },
        {
          "command": "solosync.backupNow",
          "when": "view == solosync.history && !solosync.backupRunning",
          "group": "navigation@2"
        },
        {
          "command": "solosync.cancelBackup",
          "when": "view == solosync.history && solosync.backupRunning",
          "group": "navigation@2"
        },
        {
          "command": "solosync.refresh",
          "when": "view == solosync.history",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "solosync.restoreSnapshot",
          "when": "view == solosync.history && viewItem == solosync.snapshot",
          "group": "inline@1"
        },
        {
          "command": "solosync.restoreFile",
          "when": "view == solosync.history && viewItem == solosync.snapshot",
          "group": "inline@2"
        },
        {
          "command": "solosync.verifySnapshot",
          "when": "view == solosync.history && viewItem == solosync.snapshot",
          "group": "inline@3"
        }
      ],
      "explorer/context": [
        {
          "command": "solosync.backupNow",
          "when": "resourceScheme == file",
          "group": "navigation@50"
        }
      ]
    },
    "configuration": {
      "title": "SoloSync",
      "properties": {
        "solosync.sourceDirectory": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Project folder SoloSync protects. Use 'SoloSync: Choose Project Folder' instead of editing this manually."
        },
        "solosync.backupDirectory": {
          "type": "string",
          "default": "",
          "description": "Local or mounted NAS directory where SoloSync stores snapshots. Use 'SoloSync: Choose Backup Location' instead of editing this manually."
        },
        "solosync.autoBackupAfterCommit": {
          "type": "boolean",
          "default": true,
          "description": "Create a snapshot after the current Git commit changes."
        },
        "solosync.idleBackupMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "Create a snapshot after this many minutes without further file changes. Set to 0 to disable."
        },
        "solosync.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".git",
            "out",
            "dist",
            "build",
            ".next",
            ".cache",
            ".pnpm-store",
            "*.log"
          ],
          "description": "File or directory names excluded from snapshots."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run build && node --test test/*.test.js",
    "package": "npx @vscode/vsce package",
    "render-icon": "node scripts/render-icon.cjs",
    "build": "npm run render-icon && npm run compile"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.0"
  }
}
